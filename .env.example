# ReLoop — Environment Variables Template
# Team GreenStack • Environmental Hacks
#
# NOTE: If these variables are not provided, ReLoop automatically runs in Local Demo Mode
# with complete, pre-seeded Delhi-NCR test records for immediate judging evaluation.

# AWS Region where your DynamoDB table is deployed (e.g. ap-south-1 for Mumbai, us-east-1 for N. Virginia)
AWS_REGION=ap-south-1

# Target Amazon DynamoDB Table Name (Created via CloudFormation or scripts/setup-aws-dynamodb.mjs)
DYNAMODB_TABLE_NAME=reloop-records

# IAM User Credentials with AmazonDynamoDBFullAccess or least-privilege policy (ReloopApplicationDynamoDBAccess)
# NEVER commit real secret keys to GitHub.
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Alternative prefix supported by ReLoop
# RELOOP_AWS_REGION=ap-south-1
# RELOOP_DYNAMODB_TABLE=reloop-records
# RELOOP_AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# RELOOP_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
